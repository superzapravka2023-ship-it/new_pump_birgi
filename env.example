# ── Обязательные ─────────────────────────────────────────────
TELEGRAM_TOKEN=123456:ABC-токен-от-BotFather
TELEGRAM_CHAT_ID=123456789        # твой id (узнать у @userinfobot)

# ── Стратегия ────────────────────────────────────────────────
SCAN_INTERVAL=60                  # частота скана, сек (30–60)
PUMP_LOOKBACK_MIN=5               # окно роста, минут
PUMP_THRESHOLD_PCT=5              # порог роста за окно (Bybit), %
MIN_TURNOVER_24H=5000000          # мин. оборот 24ч на Bybit, USDT
MIN_AGE_DAYS=30                   # монета старше N дней

MIN_BITGET_GAP_PCT=1.0            # Bitget должен отставать минимум на это, %
GOOD_GAP_PCT=1.5                  # «хороший» запас → +1 балл
VOL_SURGE_MULT=2.0                # всплеск объёма: посл. свеча / средняя
MIN_SCORE=2                       # мин. балл качества, чтобы прислать сигнал
RSI_PERIOD=14
COOLDOWN_MIN=30                   # не слать одну монету N минут
MAX_CONCURRENCY=12
